{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "runtime": "python",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/((?!@|.*\\.[^/]+$).*)", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/ws/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
