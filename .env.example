# ---- Vercel: Project -> Settings -> Environment Variables ----------------------------
# Injected automatically when you connect Neon (Storage tab). Do not type it by hand.
# DATABASE_URL=postgresql://...

# REQUIRED on Vercel. 64 hex chars (32-byte Ed25519 key). Generate once with:
#   python backend/scripts/generate_platform_key.py --output .env.vercel-key
# Never change it after the first deploy against the same database (the ledger is signed with it).
# TEJAS_PLATFORM_PRIVATE_KEY=

# Build-time frontend flag. "off" = no always-open WebSocket; job progress uses HTTP polling.
# Recommended on Vercel.
# VITE_LIVE_EVENTS=off

# Leave VITE_API_URL UNSET on Vercel (frontend and /api share one domain).
